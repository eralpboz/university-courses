# E switch 1.
set_property PACKAGE_PIN V17 [get_ports E]; set_property IOSTANDARD LVCMOS33 [get_ports E]

# D switch 2. 
set_property PACKAGE_PIN V16 [get_ports D]; set_property IOSTANDARD LVCMOS33 [get_ports D]

# C switch 3. 
set_property PACKAGE_PIN W16 [get_ports C]; set_property IOSTANDARD LVCMOS33 [get_ports C]

# B switch 4. 
set_property PACKAGE_PIN W17 [get_ports B]; set_property IOSTANDARD LVCMOS33 [get_ports B]

# A switch 5.
set_property PACKAGE_PIN W15 [get_ports A]; set_property IOSTANDARD LVCMOS33 [get_ports A]

# Output Led1
set_property PACKAGE_PIN U16 [get_ports F]; set_property IOSTANDARD LVCMOS33 [get_ports F]